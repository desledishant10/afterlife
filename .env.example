# AWS. Leave blank to use ~/.aws/credentials
AWS_PROFILE=default
AWS_REGION=us-east-1

# GitHub. Token scope requirements:
#   Classic PAT:      read:org, repo
#   Fine-grained PAT (recommended): scoped to one org with
#       Organization permissions  Members: Read
#                                 Administration: Read
#       Repository permissions    Administration: Read   (for deploy keys)
#                                 Metadata: Read
GITHUB_TOKEN=
GITHUB_ORG=

# GitLab. PAT with at least api or read_api scope, group-level membership.
# For self-hosted, set GITLAB_API_URL to https://gitlab.example.com/api/v4.
GITLAB_TOKEN=
GITLAB_GROUP=
GITLAB_API_URL=https://gitlab.com/api/v4

# Identity provider
IDP_PROVIDER=google  # google | okta | azure

# Google Workspace (service account JSON, with delegated admin user)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADMIN_EMAIL=

# GCP IAM. Service account JSON with iam.serviceAccounts.list and
# iam.serviceAccountKeys.list permissions on the target project. The
# account does NOT need domain-wide delegation (different from Workspace).
GCP_PROJECT=
GCP_SERVICE_ACCOUNT_JSON=

# Okta
OKTA_DOMAIN=
OKTA_API_TOKEN=

# Azure / Microsoft Entra ID. App registration with at least User.Read.All
# application permission (admin-consented).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Slack. Bot token (xoxb-...) or user token (xoxp-...) with users:read scope.
SLACK_TOKEN=

# HashiCorp Vault. Token must allow `read` on identity/entity/id (and `list`).
# Enterprise users with namespaces: set VAULT_NAMESPACE.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_NAMESPACE=

# ---------------------------------------------------------------------------
# Alerting (afterlife analyze --notify). All optional; a channel is used only
# when configured. Alerts fire for new/reopened findings at or above the
# threshold below. These values are read at run time and never persisted.
# ---------------------------------------------------------------------------

# Minimum severity to alert on: critical | high | medium | low (default high).
AFTERLIFE_NOTIFY_MIN_SEVERITY=high

# Slack Incoming Webhook URL.
AFTERLIFE_SLACK_WEBHOOK=

# Generic webhook: alerts are POSTed as JSON to this URL.
AFTERLIFE_WEBHOOK_URL=

# Email over SMTP. Set AFTERLIFE_SMTP_HOST and AFTERLIFE_EMAIL_TO to enable.
AFTERLIFE_SMTP_HOST=
AFTERLIFE_SMTP_PORT=587
AFTERLIFE_SMTP_USERNAME=
AFTERLIFE_SMTP_PASSWORD=
AFTERLIFE_SMTP_TLS=true
AFTERLIFE_EMAIL_FROM=afterlife@example.com
AFTERLIFE_EMAIL_TO=

# Jira ticketing (Pro). Files a remediation issue for new/reopened findings.
# All four are required; the issue type defaults to Task. Needs a Pro license.
AFTERLIFE_JIRA_URL=
AFTERLIFE_JIRA_EMAIL=
AFTERLIFE_JIRA_TOKEN=
AFTERLIFE_JIRA_PROJECT=
AFTERLIFE_JIRA_ISSUE_TYPE=Task

# ---------------------------------------------------------------------------
# Licensing (open core). The free edition needs nothing here. A Pro license
# is a signed token, verified locally and offline.
# ---------------------------------------------------------------------------

# Pro license token, or a path to a file containing it (use one).
AFTERLIFE_LICENSE=
AFTERLIFE_LICENSE_FILE=

# Optional local revocation: license jtis to reject on this install, either
# comma-separated here or one-per-line in the file. Most operators leave these
# empty; revoked licenses normally arrive baked into a release.
AFTERLIFE_LICENSE_DENYLIST=
AFTERLIFE_LICENSE_DENYLIST_FILE=

# Password for the Pro dashboard auth (afterlife serve --require-auth).
AFTERLIFE_DASHBOARD_PASSWORD=

# Single sign-on via OIDC (Pro, `afterlife serve --sso`). Works with Google,
# Okta, Microsoft Entra, Auth0, Keycloak, and any OIDC provider.
AFTERLIFE_OIDC_ISSUER=
AFTERLIFE_OIDC_CLIENT_ID=
AFTERLIFE_OIDC_CLIENT_SECRET=
AFTERLIFE_OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
# Restrict who may sign in (comma-separated). With NEITHER set, sign-in fails
# closed (no account is admitted) unless you opt in just below.
AFTERLIFE_OIDC_ALLOWED_DOMAINS=
AFTERLIFE_OIDC_ALLOWED_EMAILS=
# Set to 1 to intentionally admit ANY account the provider authenticates. Only
# sensible with a single-company IdP, never with a public one like plain Google.
AFTERLIFE_OIDC_ALLOW_ANY_ACCOUNT=
# Force the Secure flag on auth cookies (set when behind a TLS-terminating
# proxy; X-Forwarded-Proto: https is also honored automatically).
AFTERLIFE_OIDC_COOKIE_SECURE=
# Secret used to sign dashboard session cookies. Set a fixed value in
# production (an unset value is regenerated on restart, logging everyone out).
AFTERLIFE_SESSION_SECRET=
